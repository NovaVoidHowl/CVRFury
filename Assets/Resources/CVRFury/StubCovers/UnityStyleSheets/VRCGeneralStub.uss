#VRCGeneralStubBase{
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  padding-top: 10px;
  padding-bottom: 10px;

}
#Banner{
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

#VRCGeneralStubCoverTitle{
  font-size: 16px;
  margin: 10px;
}

#VRCGeneralStubCoverContent1,
#VRCGeneralStubCoverContent2,
#VRCGeneralStubCoverContent3{
  font-size: 13px;
  margin: 10px;
  white-space: normal;
  -unity-text-align:  middle-center;
}


#componentTypeVisualElement{
  position: absolute;
  top: -23px;
  left: 20px;
  right: 68px;
  height: 20px;
  /* background-color: #3E3E3E; */
  background-color: #202020;
}
#componentTypeVisualElement:hover{
  background-color: #202030;
}

#topBarContent{
  position: relative;
  top: 2px;
  padding-left: 10px;
}

.vrcfury-stub-inspector{
  height: 100%;
  background-color: #444444;
  margin-left: -15px;
  margin-right: -10px;
}
