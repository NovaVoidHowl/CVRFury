#VRCFuryStubBase{
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 110px;
  padding-top: 10px;
  padding-bottom: 10px;

}
#Banner{
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

#VRCFuryStubCoverTitle{
  font-size: 15px;
  margin: 10px;
}

#VRCFuryStubCoverContent{
  font-size: 10px;
  margin: 10px;
}

#errorVisualElement{
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  padding-top: 0px;
  padding-bottom: 0px;
  background-color: #660000;
  border-top-left-radius: 20px;  /* Adjust as needed */
  border-top-right-radius: 20px; /* Adjust as needed */
  border-top-color: #ff0000;
  border-right-color: #ff0000;
  border-left-color: #ff0000;
  border-top-width: 2px;
  margin-top: 10px;  /* Add space above error messages */
}
#errorVisualElement .unity-label{
  font-size: 13px;
  padding-bottom: 4px;
  white-space: normal;
  -unity-text-align:  middle-center;
  margin-left: 4px;
  margin-right: 4px;
}
#errorVisualElement .unity-button{
  font-size: 14px;
  margin-left: 4px;
  margin-right: 4px;
  margin-top: 6px;
}
#errorVisualElement .warning-title{
  font-size: 14px;
  margin-left: 4px;
  margin-right: 4px;
  margin-bottom: 10px;
  border-bottom-width: 1px;
  border-bottom-color: #afafaf;

}

#componentTypeVisualElement{
  position: absolute;
  top: -23px;
  left: 20px;
  right: 68px;
  height: 20px;
}

#topBarContent{
  position: relative;
  padding-left: 10px;
  flex-direction: row;
  display: flex;
}

#unsupportedVisualElement{
  position: absolute;
  top: -20px;
  right: 72px;
}

.cvr-fury-inspector{
  height: 100%;
  background-color: #444444;
  margin-left: -15px;
  margin-right: -10px;
}

#VRCFuryStubCoverActionButton {
  display: none;
  font-size: 14px;
  padding: 4px;
}

.version-label {
  position: absolute;
  top: 0px;
  left: 0px;
  background-color: #505050;
  color: #fff;
  padding-top: 5px;
  padding-bottom: 5px;
  padding-left: 5px;
  padding-right: 10px;
  font-size: 12px;
  border-radius: 0 0 10px 0;
}

.version-ok-label {
  border-color: #090;
  border-width: 0 1px 1px 0;
}

.version-error-label {
  border-color: #900;
  border-width: 0 2px 2px 0;
}

.action-summary-container {
    margin-top: 10px;
    margin-left: 10px;
    margin-right: 10px;
    margin-bottom: 0px;
    padding: 8px;
    border-radius: 4px;
    background-color: rgba(40, 40, 40, 0.4);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    display: flex;
    flex-direction: column;
    min-width: 200px;
    width: 95%;
    align-self: center;
    position: relative;
    flex-shrink: 0;
    flex-grow: 0;
    height: auto;
    overflow: visible;
    padding-bottom: 6px;
}

.action-summary-header {
    -unity-font-style: bold;
    margin-bottom: 8px;
    padding: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
    position: relative;
}

.action-count-label {
    margin: 2px 10px;
    padding: 1px;
    font-size: 11px;
    white-space: normal;
    flex-shrink: 0;
    width: auto;
    position: relative;
}

.action-total-label {
    margin-top: 8px;
    margin-left: 10px;
    padding: 2px;
    -unity-font-style: bold;
    font-size: 11px;
    flex-shrink: 0;
    width: auto;
    position: relative;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
}
