.root-container {
    padding: 10px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
}

.blend-shape-container {
    margin-bottom: 10px;
    padding: 10px;
    background-color: #303030;
    border-radius: 0px 0px 12px 12px;
    border-width: 0px 1px 1px 1px;
    border-color: #404040;
    flex-grow: 1;
    width: 100%;
    min-width: 0;
    overflow: hidden;
}

.objects-container{
    margin-bottom: 0px;
    padding: 10px;
    background-color: #303030;
    border-radius: 6px 6px 0px 0px ;
    border-width: 1px 1px 0px 1px;
    border-color: #404040;
    flex-grow: 1;
    width: 100%;
    min-width: 0;
    overflow: hidden;
}

.path-container {
    margin-bottom: 10px;
    padding: 10px;
    background-color: #303030;
    border-radius: 6px;
    border-width: 1px;
    border-color: #404040;
    flex-direction: column;
    align-items: center;
}

.generate-button {
    margin: 5px;
    padding: 8px;
    background-color: #444444;
    border-width: 1px;
    border-color: #646464;
    border-radius: 3px;
    -unity-text-align: middle-center;
    font-size: 12px;
    transition: background-color 0.2s;
    height: 30px;
}

.generate-button:hover {
    background-color: #555555;
}

.generate-button:active {
    background-color: #333333;
}

.generate-button:disabled {
    opacity: 0.5;
    background-color: #3a3a3a;
}

TextField {
    margin: 0;
    padding: 2px 4px;
    width: 100%;
    height: 18px;
    min-height: 18px;
    min-width: 0;
    flex-shrink: 1;
    flex-grow: 1;
}

ObjectField {
    margin: 0;
    padding: 2px 4px;
    width: 100%;
    height: 18px;
    min-height: 18px;
    min-width: 0;
    flex-shrink: 1;
    flex-grow: 1;
}

.unity-base-field__input {
    flex-grow: 1;
    width: auto;
    min-width: 0;
}

.unity-object-field__input {
    left: 4px;
    min-width: 0;
    max-width: 99.8%;
    height: 18px;
    flex-shrink: 1;
    flex-grow: 1;
}

.spacer {
    height: 10px;
}