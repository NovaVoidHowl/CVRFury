#devModeTag{
  position: absolute;
  top: 0;
  right: 0;
  background-color: #000090;
  color: #ffffff;
  padding: 5px;
  font-size: 12px;
  border-radius: 0 0 0 10px;
}

#defaultEditorContainer{
  padding-bottom: 10px;
  padding-top: 10px;
  padding-left: 10px;
  padding-right: 10px;
  border-width: 1px 0px 0px 0px;
  border-color: #ffffff;

}

#featureAdderContainerV2{
  margin-top: 10px;
  padding-bottom: 10px;
  padding-top: 10px;
  padding-left: 10px;
  padding-right: 10px;
  border-width: 1px 1px 1px 1px;
  border-color: #ffffff;

}

#incompatibilityTag {
    position: absolute;
    top: 0px;
    left: 50%;
    right: auto;
    width: auto;
    min-width: 80px;
    translate: -50% 0;
    background-color: #660000;
    color: #ffffff;
    padding: 4px 8px;
    border-radius: 0 0 10px 10px;
    font-size: 12px;
    -unity-text-align: middle-center;
}
