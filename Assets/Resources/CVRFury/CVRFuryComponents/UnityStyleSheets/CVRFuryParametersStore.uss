.section-header {
  font-size: 12px;
  -unity-font-style: bold;
  margin-bottom: 5px;
  -unity-text-align: middle-center;
}

#root-container {
    padding-top: 0px;
    padding-bottom: 5px;
    padding-left: 0px;
    padding-right: 0px;
}

.parameters-list {
    margin: 5px 0;
}

.parameter-item {
    margin: 2px 0;
    padding: 5px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--unity-colors-default-border);
}

.cvr-fury-buttons-container {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding: 10px;
}

.spacer {
    height: 10px;
}

.stores-container {
    margin-bottom: 10px;
    padding: 10px;
    background-color: #303030;
    border-radius: 12px 12px 0px 0px;
    border-width: 1px;
    border-color: #404040;
    flex-grow: 1;
    width: 100%;
    min-width: 0;
    overflow: hidden;
}

.stores-header {
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 5px;
    -unity-text-align: middle-center;
}

.unity-list-view {
    height: auto;
    min-height: 10px;
    background-color: var(--unity-colors-default-background);
    overflow: hidden;
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 4px 8px;
}

.unity-object-field {
    padding-left: 2px;
    padding-right: 2px;
    width: auto;
    min-height: 20px;
    flex-grow: 1;
    flex-shrink: 0;
}

.unity-list-view__item {
    height: 24px;
    min-height: 24px;
    padding: 2px 0;
    margin: 0;
    width: 100%;
    overflow: hidden;
}

.parameter-field {
    margin: 0;
    padding: 2px 4px;
    width: 100%;
    height: 22px;
    min-height: 22px;
    min-width: 0;
    flex-shrink: 1;
    flex-grow: 1;
}

.parameter-field.unity-object-field.empty-slot .unity-object-field__input {
    border-color: rgb(200, 0, 0);
    border-width: 1px;
}

.unity-object-field__input {
    display: flex;
    opacity: 1;
    min-height: 20px;
    flex-grow: 1;
    flex-shrink: 0;
}

.unity-base-field__input {
    flex-grow: 1;
    width: auto;
    min-width: 0;
}

.unity-object-field-display {
    height: 20px;
    min-height: 18px;
}

.unity-object-field-display__icon {
    width: 16px;
    height: 16px;
    margin: 1px;
}

.unity-object-field-display__label {
    font-size: 11px;
    -unity-text-align: middle-left;
    padding-left: 4px;
}

.unity-object-field__selector {
    width: 18px;
    height: 18px;
}

.unity-list-view {
    padding-left: 0px;
    padding-right: 1px;
}

.cvr-fury-button {
    margin: 5px;
    padding: 8px;
    background-color: #444444;
    border-width: 1px;
    border-color: #646464;
    border-radius: 3px;
    -unity-text-align: middle-center;
    font-size: 12px;
    transition: background-color 0.2s;
}

.cvr-fury-button:hover {
    background-color: #555555;
}

.cvr-fury-button:active {
    background-color: #333333;
}

.cvr-fury-button:disabled {
    opacity: 0.5;
    background-color: #3a3a3a;
}

.parameters-foldout {
    margin: 0;
    padding: 0;
}

.parameters-foldout .unity-foldout__toggle {
    margin: 0;
    padding: 0;
}

.parameters-foldout .unity-foldout__content {
    margin-left: 0;
    padding-left: 0;
}

.unity-property-field {
    margin: 0;
    padding: 0;
}

.unity-property-field__label {
    min-width: 100px;
}

.parameter-row {
    flex-direction: row;
    align-items: center;
    padding: 2px;
}

.parameter-name-field {
    flex-grow: 1;
    flex-shrink: 1;
    max-width: 60%;
}

.parameter-type-field {
    width: 60px;
    flex-shrink: 0;
}

.parameter-value-field {
    width: 60px;
    flex-shrink: 0;
}

.unity-float-field {
    width: 40px;
}

.unity-float-field__input {
    margin: 0;
    /* padding: 2px 4px; */
    min-width: 0;
}

/* Adjust spacing between fields */
.unity-base-field {
    margin-right: 2px;
}

/* custom extra spacing for left most field to make the line easier to select */
.parameter-leftmost-field {
    margin-left: -10px;
    padding-left: 0px;
}

.sort-button {
    margin: 2px;
    padding: 2px 8px;
    font-size: 10px;
    background-color: #444444;
    border-width: 1px;
    border-color: #646464;
    border-radius: 3px;
}

.sort-button:hover {
    background-color: #555555;
}

.parameters-controls {
    padding: 2px;
}

.unity-object-field.warning-state .unity-object-field__input {
    border-width: 1px;
    border-color: rgb(230, 0, 0);
}
  
.message-banner-container {
    display: none;
    padding: 8px;
    left: 0;
    right: 0;
    margin-bottom: 10px;
    margin-left: -15px;
    margin-right: -5px;
}

.message-banner-error {
    display: flex;
    background-color: rgba(200, 0, 0, 0.4);
    border-width: 0px 1px 1px 1px;
    border-radius: 0px 0px 12px 12px;
    border-color: rgb(200, 0, 0);
}

.message-banner-text {
    color: rgb(255, 200, 200);
    -unity-font-style: bold;
    white-space: normal;
    font-size: 12px;
}

.unity-list-view__reorder-hover-bar {
    background-color: var(--unity-colors-highlight-background);
    height: 2px;
}

/* Add these new styles to CVRFuryParametersStore.uss */

/* Parameter list item container */
.parameter-list-item {
    flex-direction: row;
    width: 100%;
}

/* Name field styling */
.parameter-name-field {
    flex-grow: 1;
    flex-shrink: 1;
    max-width: 60%;
}

/* Type field styling */
.parameter-type-field {
    width: 60px;
    flex-shrink: 0;
}

/* Default value field styling */
.parameter-value-field {
    width: 60px;
    flex-shrink: 0;
}

.unity-object-field__object {
    opacity: 1;
    display: flex;
}

/* Object field icon states */
.empty-slot .unity-object-field__object {
    opacity: 0;
    display: flex;
}

.empty-slot .unity-object-field__input {
    display: flex;
    opacity: 1;
    min-height: 20px;
    flex-grow: 1;
    flex-shrink: 0;
}

.warning-container {
    position: absolute;
    right: 4px;
    top: 3px;
    width: 16px;
    height: 16px;
}

.warning-icon {
    width: 16px;
    height: 16px;
}

.unity-list-view__reorderable-item {
    flex-direction: row;
    align-items: center;
    padding: 0px !important;
}

.unity-list-view__reorderable-handle {
    width: 20px;
    min-width: 20px;
    align-items: center;
    justify-content: center;
    opacity: 1;
    margin-right: 4px;
    -unity-background-image-tint-color: var(--unity-colors-default-text);
}

.unity-list-view__reorderable-handle-bar {
    width: 10px;
    height: 1px;
    margin: 1px;
    background-color: var(--unity-colors-default-text);
}

.parameter-list-item {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.unity-list-view__item:hover .unity-list-view__reorderable-handle {
    opacity: 1;
}


.error-banner {
    background-color: var(--unity-colors-error-background);
    padding: 8px;
    margin-bottom: 8px;
    flex-direction: row;
    align-items: center;
}

.error-icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
}

.error-label {
    color: var(--unity-colors-error-text);
    -unity-font-style: bold;
}

.unity-object-field__selector {
    display: none;
}

/* Also add this to ensure the object field display takes up the full width */
.unity-object-field__input {
    flex-direction: row;
    justify-content: flex-start;
}

.unity-object-field-display {
    flex-grow: 1;
    flex-shrink: 1;
}
