#CVRFuryAvatarColliderInfoUnitEditor{
  display: flex;
  justify-content: center;
  align-items: center;
  height: auto;
  padding-bottom: 10px;
  width: 100%;
}
#Banner{
  height: auto;
  display: flex;
  justify-content: center;
  align-items: center;
}
#Banner #CoverTitle{
  font-size: 20px;
  margin: 10px;
  }
#Banner #Content1{
  font-size: 12px;
  }

#CVRFuryAvatarColliderInfoUnitEditor #logo{
  position: absolute;
  top: 4px;
  left: 4px;
  width: 64px;
  height: 32px;
}

#Status{
  height: auto;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding-top: 10px;
}

#Status #AvatarLinkTitle{
  font-size: 12px;
  margin-right: 10px;
  -unity-font-style: bold;
}

#Status #AvatarLinkContent{
  font-size: 12px;
  }


#Controls{
  display: flex;
  justify-content: center;
  align-items: center;
  height: auto;
  padding-top: 10px;
  padding-bottom: 10px;
  padding-right: 10px;
  width: 100%;
}

#Controls #ShowColliders{
  height: 30px;
  margin: 5px;
  border-radius: 4px;
  width: 100%;
}

#Controls #ShowColliders.enabled {
    background-color: rgb(0, 150, 0);
    color: white;
}

#Controls #ShowColliders:hover {
    background-color: rgb(60, 60, 60);
}

#Controls #ShowColliders.enabled:hover {
    background-color: rgb(0, 130, 0);
}



.cvr-fury-inspector{

  background-color: #444444;
  margin-left: -15px;
  margin-right: -10px;
}

/* Collider Configuration Styling */
#CollidersConfig {
  margin-top: 10px;
  padding: 5px;
  border-radius: 4px;
  background-color: rgba(60, 60, 60, 0.2);
  width: 100%;
}

#CollidersConfig .status-label{
  position: absolute;
  top: 5px;
  right: 5px;
}


#CollidersConfigTitle {
  font-size: 14px;
  -unity-font-style: bold;
  margin-bottom: 10px;
}

.collider-foldout {
  margin: 2px 0;
  background-color: rgba(40, 40, 40, 0.3);
  border-radius: 3px;
  width: 100%;
}

/* Make sure foldout toggle and content span the full width */
.unity-foldout {
  width: 100%;
}

.unity-foldout__toggle {
  width: 100%;
  margin-right: 0;
}

.unity-foldout__content {
  width: 96%;
}

/* Ensure the toggle text takes full width */
.unity-foldout__text {
  flex-grow: 1;
  -unity-font-style: bold;
}

.collider-container {
  padding: 5px;
}

.properties-container {
  margin-left: 0px;
}

.custom-properties-container {
  margin-top: 10px;
  padding-top: 5px;
}

.rotation-container {
  flex-direction: row;
  flex-wrap: wrap;
}

.rotation-container > Label {
  width: 100%;
}

.rotation-container > FloatField {
  width: 60px;
  margin-right: 10px;
}

/* Custom enum field styling */
.unity-enum-field {
  margin: 5px 0;
}

/* Styling for value fields */
.unity-base-field {
  margin: 3px 0;
}

.unity-base-field__input {
  min-width: 50px;
}

/* Custom Switch Toggle Styles */
.switch-toggle {
  margin-bottom: 6px;
}

.switch-toggle-container {
  flex-direction: row;
  align-items: center;
  justify-content: flex-start; /* Left align contents */
}

.switch-toggle-label {
  margin-right: 8px;
  flex-grow: 0; /* Don't expand to fill space */
  width: auto; /* Let the label take its natural width */
  min-width: 160px; /* Set a minimum width for consistent alignment */
}

.switch-toggle-track {
  width: 40px;
  height: 20px;
  border-radius: 10px;
  background-color: #666666;
  transition: background-color 0.2s;
  position: relative;
  margin-left: 4px; /* Small margin from label */
}

.switch-toggle-knob {
  width: 16px;
  height: 16px;
  border-radius: 8px;
  background-color: white;
  position: absolute;
  top: 2px;
  left: 2px;
  transition: left 0.2s;
}

.switch-toggle-track-active {
  background-color: #2196F3;
}

.switch-toggle-knob-active {
  left: 22px;
}

/* Hover effects */
.switch-toggle:hover .switch-toggle-track {
  background-color: #777777;
}

.switch-toggle:hover .switch-toggle-track-active {
  background-color: #0A7AD6;
}
